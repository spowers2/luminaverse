{
  "expo": {
    "name": "LuminaVerse",
    "slug": "luminaverse",
    "version": "1.4.0",
    "description": "Daily Bible verses with peaceful music and streak tracking. Find inspiration through beautiful scripture in a distraction-free interface.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4a7c7e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.labazine.luminaverse",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "LuminaVerse needs access to save beautiful verse images to your Photos.",
        "NSPhotoLibraryAddUsageDescription": "LuminaVerse needs access to save beautiful verse images to your Photos.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4a7c7e"
      },
      "package": "com.labazine.luminaverse",
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM", "android.permission.READ_MEDIA_IMAGES", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.READ_MEDIA_VISUAL_USER_SELECTED", "android.permission.ACCESS_MEDIA_LOCATION", "android.permission.READ_MEDIA_VIDEO", "android.permission.READ_MEDIA_AUDIO"]
    },
    "plugins": [
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4a7c7e"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow LuminaVerse to save beautiful verse images to your Photos.",
          "savePhotosPermission": "Allow LuminaVerse to save beautiful verse images to your Photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "spowers2",
    "extra": {
      "eas": {
        "projectId": "d9de421b-13ad-401f-beca-418b16e8f1b0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d9de421b-13ad-401f-beca-418b16e8f1b0"
    }
  }
}
